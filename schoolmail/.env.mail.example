# Copy to .env.mail and fill in. Never commit .env.mail.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=                 # Gmail: an app password (Google Account -> Security -> App passwords)
MAILBOX=INBOX
MAIL_ALLOWED_FROM=             # owner's addresses that forward school mail, comma-separated
MAIL_SCHOOL_DOMAINS=           # school domains, comma-separated (subdomains match too)
# MAIL_MAX_BYTES=10485760      # optional, message size limit, default 10 MB
